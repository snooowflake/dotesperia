[Unit]
Description=Dotesperia private HTTPS interface
Requires=dotesperia.service
After=dotesperia.service

[Service]
User=dotesperia-net
Group=dotesperia-net
EnvironmentFile=/opt/dotesperia/runtime.env
WorkingDirectory=/opt/dotesperia/repo
ExecStart=/opt/dotesperia/node-v24.21.0-linux-x64/bin/node --experimental-strip-types server/private-web-gateway.ts
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/esperiashield-iphone /home/dotesperia
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
